{
  "name": "weeklies",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "build:android": "eas build -p android --profile development",
    "build:android:preview": "eas build -p android --profile preview",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:web": "expo export -p web",
    "deploy:web": "npm run build:web && eas deploy",
    "deploy:web:prod": "npm run build:web && eas deploy --prod",
    "lint": "expo lint",
    "check:licenses": "node scripts/check-licenses.js",
    "prebuild:android": "expo prebuild --platform android --no-install",
    "test": "jest",
    "test:watch": "jest --watchAll",
    "prepare": "husky"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg)"
    ]
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.21.0",
    "@react-navigation/elements": "^2.9.45",
    "@react-navigation/native": "^7.5.1",
    "expo": "~58.0.16",
    "expo-constants": "~58.0.12",
    "expo-crypto": "~58.0.7",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.10",
    "expo-font": "~58.0.9",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.16",
    "expo-linking": "~58.0.13",
    "expo-router": "~58.0.24",
    "expo-splash-screen": "~58.0.10",
    "expo-status-bar": "~58.0.3",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-web-browser": "~58.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-toast-message": "^2.5.2",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "~30.0.0",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.18",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "expo-dev-client": "~58.0.14",
    "eslint-import-resolver-typescript": "~3.9.0",
    "husky": "^9.1.7",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.11",
    "test-renderer": "^1.3.1",
    "typescript": "~6.0.3"
  },
  "private": true
}
